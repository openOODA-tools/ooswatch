# Maintainer: openOODA-tools <ops@openooda.org>
pkgname=ooswatch-bin
_pkgname=ooswatch
pkgver=0.1.0
pkgrel=1
pkgdesc="Displays interactive 16-color ANSI and TrueColor terminal swatches."
arch=('x86_64')
url="https://github.com/openOODA-tools/ooswatch"
license=('Apache-2.0')
depends=('glibc')
provides=('ooswatch')
conflicts=('ooswatch')
source_x86_64=("${url}/releases/download/v${pkgver}/ooswatch-linux-x86_64"
               "uninstall.sh::https://raw.githubusercontent.com/openOODA-tools/${_pkgname}/v${pkgver}/uninstall.sh")
sha256sums_x86_64=('SKIP'
                   'SKIP')

package() {
    install -Dm755 "${srcdir}/ooswatch-linux-x86_64" "${pkgdir}/usr/bin/ooswatch"
    install -Dm755 uninstall.sh "${pkgdir}/usr/bin/ooswatch-uninstall"
}
